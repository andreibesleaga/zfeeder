---
title: "One port, two adapters"
---
flowchart LR
    users["FeedService · Admin · CLI<br/>name no concrete store"]

    subgraph ports["Ports"]
        si["SubscriptionStoreInterface<br/>categories, read, save,<br/>create, delete, import, export"]
        ci["CacheStoreInterface<br/>get, put, delete, purge, urls"]
    end

    subgraph flat["Flat adapter — the 2004 shape"]
        fo["OpmlSubscriptionStore<br/>one .opml per category"]
        fc["FileCacheStore<br/>sha256(url) + sidecar metadata"]
    end

    subgraph sql["SQLite adapter"]
        so["SqliteSubscriptionStore"]
        sc["SqliteCacheStore"]
        db["Database<br/>WAL, prepared statements,<br/>versioned migrations"]
    end

    fac["StoreFactory<br/>reads ZF_STORAGE"]
    mig["Migrator<br/>copies and verifies counts"]
    test["One abstract test case<br/>run against both"]

    users --> ports
    fac --> ports
    ports --> flat
    ports --> sql
    so --> db
    sc --> db
    flat <-.->|"migrate --to="| mig
    mig <-.-> sql
    test -.->|"proves they are<br/>indistinguishable"| ports

    classDef p fill:#e8f2f8,stroke:#006699,color:#16202a
    classDef a fill:#eef7ee,stroke:#4a9a5a,color:#16202a
    classDef t fill:#fffbe6,stroke:#d19a4a,color:#16202a
    class si,ci p
    class fo,fc,so,sc,db a
    class test t
